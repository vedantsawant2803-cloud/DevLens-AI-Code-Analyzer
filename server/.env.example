PORT=5000

# FREE — Get your key at: https://aistudio.google.com/app/apikey
# Gemini 1.5 Flash: 15 requests/min, 1 million tokens/day, no credit card
GEMINI_API_KEY=your_gemini_api_key_here

# Optional but recommended — increases GitHub rate limit from 60 to 5000 req/hour
# Get at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_personal_access_token_here

CLIENT_URL=http://localhost:5173
