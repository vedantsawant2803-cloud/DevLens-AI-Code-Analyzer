NODE_ENV=development
PORT=5000

# Comma-separated allowed frontend origins (production)
CLIENT_URL=http://localhost:5173

# Public URL of this API (for OAuth callback + badges)
API_PUBLIC_URL=http://localhost:5000

# Required — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Recommended — increases GitHub rate limit
GITHUB_TOKEN=your_github_personal_access_token_here

# Required in production — use: openssl rand -hex 32
COOKIE_SECRET=change-this-to-a-long-random-secret

# Optional — GitHub OAuth for private repos
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
